{
  "description": "Cerberus: record edits, and refuse a readiness claim while they are unverified.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.codex/hooks/cerberus_mark.py",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"/.codex/hooks/cerberus_gate.py",
            "timeout": 20,
            "statusMessage": "Checking the work was verified"
          }
        ]
      }
    ]
  }
}
