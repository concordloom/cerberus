{
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "//": "The version is not decoration here: a marketplace plugin is pinned to the string in its entry, so an existing installation updates only when it changes. Both manifests must carry the new number or the release reaches nobody.",
        "prepareCmd": "python3 scripts/set_version.py ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          ".claude-plugin/marketplace.json",
          "plugins/cerberus/.claude-plugin/plugin.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
